# Copy to `.env` and fill in. Never commit the real .env (see .gitignore).

# --- Multi-platform publisher (REQUIRED) -------------------------------------
# Ayrshare API key. One key fans out to LinkedIn, YouTube, TikTok, Instagram.
# Get it: https://app.ayrshare.com  ->  API Key.
# Each social account must be linked once in the Ayrshare dashboard.
AYRSHARE_API_KEY=

# --- Descript editing (OPTIONAL) --------------------------------------------
# Needed only if you run the Descript edit step as code (src/descript.py).
# Settings -> API Tokens in Descript. Token is scoped to one Drive.
DESCRIPT_API_TOKEN=

# --- AI caption generation (OPTIONAL) ---------------------------------------
# Only used when CAPTIONS_USE_AI=1. Otherwise captions come from templates.
ANTHROPIC_API_KEY=
CAPTIONS_USE_AI=0
